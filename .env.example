# Copiá este archivo como .env.local para probar en tu computadora.
# En Vercel, cargá estas mismas variables en Settings → Environment Variables.

# Dirección pública de tu web (sin barra al final). Ej: https://sorteo-auto.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API (o "API Keys")
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# La clave SECRETA (service_role o "secret key" sb_secret_...). Nunca la compartas.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago Developers → Tus integraciones → tu aplicación → Credenciales
# Usá primero las de PRUEBA (TEST-...) y después las de PRODUCCIÓN (APP_USR-...).
MP_ACCESS_TOKEN=
# Mercado Pago → tu aplicación → Webhooks → "Clave secreta" (opcional pero recomendado)
MP_WEBHOOK_SECRET=

# Contraseña para entrar a /admin. Elegí una larga y difícil.
ADMIN_PASSWORD=
