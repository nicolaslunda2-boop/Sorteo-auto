# Variables de entorno. En Vercel van en Settings → Environment Variables.
# Para probar en tu computadora, copiá este archivo como .env.local.

# ── Obligatorias ─────────────────────────────────────────────
# Mercado Pago Developers → tu aplicación → Credenciales (de prueba o de producción)
MP_ACCESS_TOKEN=
# Contraseña para entrar a /admin
ADMIN_PASSWORD=

# ── Base de datos ───────────────────────────────────────────
# Si conectás Supabase desde Vercel (Storage → Supabase), estas se cargan solas.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Conexión directa a Postgres: la usa el botón "Preparar la web" para crear las tablas.
POSTGRES_URL=

# ── Opcionales ──────────────────────────────────────────────
# Dirección pública de la web. En Vercel se detecta sola.
NEXT_PUBLIC_SITE_URL=
# Mercado Pago → tu aplicación → Webhooks → clave secreta
MP_WEBHOOK_SECRET=
