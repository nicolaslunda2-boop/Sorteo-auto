# Variables de entorno. En Vercel van en Settings → Environment Variables.
# Para probar en tu computadora, copiá este archivo como .env.local.

# ── Obligatorias ─────────────────────────────────────────────
# Contraseña para entrar a /admin
ADMIN_PASSWORD=

# ── Pago por transferencia (alcanza con alias o CBU) ────────
TRANSFER_ALIAS=
TRANSFER_CBU=
TRANSFER_TITULAR=
TRANSFER_BANCO=
# WhatsApp para recibir comprobantes: 549 + área sin 0 + número sin 15. Ej: 5491155555555
WHATSAPP_NUMERO=

# ── Base de datos ───────────────────────────────────────────
# Si conectás Supabase desde Vercel (Storage → Supabase), estas se cargan solas.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Conexión directa a Postgres: la usa el botón "Preparar la web" para crear las tablas.
POSTGRES_URL=

# ── Opcionales ──────────────────────────────────────────────
# Dirección pública de la web. En Vercel se detecta sola.
NEXT_PUBLIC_SITE_URL=
# Mercado Pago (opcional): agrega el pago con tarjeta además de la transferencia
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
